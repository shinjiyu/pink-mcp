{
  "name": "pink-mcp",
  "displayName": "PinK MCP",
  "description": "把 PinK 里的 pink_* 工具暴露成本机 MCP，供 Cursor 调用",
  "version": "0.2.0",
  "publisher": "local",
  "license": "MIT",
  "engines": {
    "vscode": "^1.110.0"
  },
  "categories": ["Other"],
  "activationEvents": ["onStartupFinished", "onPinkInit"],
  "main": "./extension.js",
  "scripts": {
    "test": "node scripts/test-server.js",
    "install-pink": "node scripts/install-pink.js"
  },
  "contributes": {
    "commands": [
      {
        "command": "pinkMcp.copyConfig",
        "title": "PinK MCP: 复制 Cursor 配置"
      },
      {
        "command": "pinkMcp.restart",
        "title": "PinK MCP: 重启服务"
      }
    ],
    "configuration": {
      "title": "PinK MCP",
      "properties": {
        "pinkMcp.port": {
          "type": "number",
          "default": 37720,
          "minimum": 1024,
          "maximum": 65535,
          "description": "网关端口。第一个 PinK 窗口占用它；其余窗口自动递增。只绑定 127.0.0.1。"
        },
        "pinkMcp.token": {
          "type": "string",
          "default": "",
          "description": "覆盖本机令牌。留空则使用 ~/.pink/mcp/token（自动生成，权限 600）。请求必须带 Authorization: Bearer <token>。"
        },
        "pinkMcp.exposeWrites": {
          "type": "boolean",
          "default": false,
          "description": "为 true 时才把写入和场景工具列入 MCP。从 Cursor 调用仍会走 PinK Chat 确认，默认失败。"
        },
        "pinkMcp.allowInsecureNoToken": {
          "type": "boolean",
          "default": false,
          "description": "为 true 时允许无令牌访问。只用于本机排障，不要开着。"
        },
        "pinkMcp.stateDir": {
          "type": "string",
          "default": "",
          "description": "实例登记目录。留空为 ~/.pink/mcp。"
        }
      }
    }
  }
}
